# PICT College ERP Backend Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pict_erp

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_pict_erp_key_replace_in_production
SESSION_EXPIRES_IN=7d
COOKIE_NAME=pict_session
