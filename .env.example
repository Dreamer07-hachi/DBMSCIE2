# ─────────────────────────────────────────────────────────────────────────────
# PICT College ERP — Frontend environment example (copy to .env)
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to use in-browser mock authentication (no backend required).
# Set to false when the Express backend server is running on port 5000.
VITE_USE_MOCK_AUTH=true

# Set to true to use mock dashboard data.
VITE_USE_MOCK_DASHBOARD=true

# Base URL of the API backend (leave empty when using Vite proxy, i.e. localhost).
VITE_API_BASE_URL=
